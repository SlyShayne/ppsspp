              { "kind": "polygon", "points": [[0, 0], [195, 0], [117, 78], [0, 78]], "fill": "cfg_yellow", "visible": "v{i} == 1" },
              { "kind": "polygon", "points": [[195, 0], [319, 0], [319, 78], [117, 78]], "fill": "cfg_yellow", "visible": "v{i} == 0" },
            ] },
            { "type": "image", "rect": [848, 27, 68, 28], "src": "assets/game/cfg_on.png", "fill": "stretch", "visible": "{i} != 1 || v0 == 1",
              "tint": "v{i} == 1 ? '#003B5D' : '#2695FF'" },
