              { "type": "image", "rect": [436, 0, 40, 48], "src": "assets/game/pill_right.png", "fill": "stretch" },
              { "type": "image", "rect": [76, "8 - 52 * pill", 328, 32], "src": "assets/game/text_new.png", "fill": "stretch", "tint": "#0F0F30" },
              { "type": "image", "rect": [56, "60 - 52 * pill", 360, 32], "src": "assets/game/text_load.png", "fill": "stretch", "tint": "#0F0F30" },
              { "type": "image", "rect": [116, "110 - 52 * pill", 236, 36], "src": "assets/game/text_config.png", "fill": "stretch", "tint": "#0F0F30" },
              { "type": "image", "rect": [48, "162 - 52 * pill", 380, 36], "src": "assets/game/text_install.png", "fill": "stretch", "tint": "#0F0F30" },
            ] },
            // Taps: each item's whole row, wider than its pill.
            { "type": "rect", "rect": [560, 778, 680, 52], "on_tap": { "call": "tap_menu", "args": [0] } },
            { "type": "rect", "rect": [560, 830, 680, 52], "on_tap": { "call": "tap_menu", "args": [1] } },
            { "type": "rect", "rect": [560, 882, 680, 52], "on_tap": { "call": "tap_menu", "args": [2] } },
