                { "type": "rect", "rect": [0, 0, 588, 92], "bg": "{g} ? '#7A1033' : '#00305A'", "radius": 6 },
                { "type": "image", "rect": [12, 10, 56, 72], "src": "assets/game/card_s_{sl_card{r}}.png" },
                { "type": "label", "rect": [84, 10, 180, 30], "text": "{sl_rank{r}}", "font": "assets/game/font_home_white.json", "size": 52 },
                { "type": "label", "rect": [84, 46, 180, 30], "text": "{sl_arc{r}}", "font": "assets/game/font_home_gold.json", "size": 52 },
                { "type": "label", "rect": [270, 28, 310, 30], "text": "{sl_name{r}}", "font": "assets/game/font_home_white.json", "size": 52, "scale_x": "sl_name_s{r}", "scale_y": "sl_name_s{r}", "origin": [0, 0.5] },
                { "type": "rect", "rect": [0, 0, 588, 92], "border": 4, "border_color": "#F5B630", "radius": 6, "visible": "sl_sel == {r}" },
                { "type": "rect", "rect": [0, 0, 588, 92], "on_tap": { "call": "tap_link", "args": ["{r}"] } },
              ] },
              { "type": "label", "rect": [0, 20, 588, 40], "text": "No Social Links yet.", "font": "assets/game/font_home_ink{g}.json", "size": 52, "visible": "sl_n == 0" },
              { "type": "group", "rect": [0, 700, 588, 260], "visible": "sl_n > 0", "children": [
                { "type": "rect", "rect": [0, 0, 588, 252], "bg": "{g} ? '#FFD3E2' : '#73B5F7'", "radius": 12 },
                { "type": "image", "rect": [16, 16, 176, 220], "src": "assets/game/bust_{sl_s_bust}.png" },
                { "type": "label", "rect": [216, 22, 360, 30], "text": "{sl_s_name}", "font": "assets/game/font_home_ink{g}.json", "size": 52, "scale_x": "sl_s_name_s", "scale_y": "sl_s_name_s", "origin": [0, 0.5] },
                { "type": "label", "rect": [216, 64, 360, 30], "text": "{sl_s_arc}", "font": "assets/game/font_home_acc{g}.json", "size": 52 },
                { "type": "rect", "repeat": "10", "repeat_var": "p", "rect": ["216 + 35 * {p}", 116, 30, 10], "bg": "sl_s_rank > {p} ? '#F5B630' : ({g} ? '#A8274F' : '#1F5C9E')" },
                { "type": "label", "rect": [216, 140, 360, 30], "text": "Rank {sl_s_rank}", "font": "assets/game/font_home_ink{g}.json", "size": 52 },
              ] },
            ] },
          ] },
        ] },
        // ---- The name keyboard (scripts/keyboard.lua), here instead of on the game's screen: the game's own, at 4x
        // (assets/game/kb_*, built by gungnir/tools/p3p_keyboard.py), two blocks a page, under a copy of the name being
        // written between the page buttons. Tapping a key types it; Del, L, R and End press the game's buttons, lit
        // when the game would take them. It comes in over the Dark Hour green on the misty blue of the game's name
        // screen, building up as the game's does (the frame, then each row); a row the cursor leaves fades back to
        // blue, and the cursor's glow pulses while it rests. It dims while the game asks "Proceed?", and goes to
        // black with the game's screen once the name is taken.
        { "type": "group", "rect": [0, 0, 1240, 1080], "visible": "kb_on", "children": [
          { "type": "image", "rect": [0, 0, 1240, 1080], "src": "assets/game/kb_bg.png", "fill": "stretch" },
          { "type": "image", "rect": [96, 216, 1048, 608], "src": "assets/game/kb_frame{kb_page}.png", "opacity": "kb_frame" },
          { "type": "group", "repeat": "6", "repeat_var": "r", "rect": [96, "312 + 64 * {r}", 1048, "{r} < 5 ? 64 : 96"], "clip": true,
            "opacity": "kb_row{r}", "children": [
            { "type": "image", "rect": [0, "-96 - 64 * {r}", 1048, 608], "src": "assets/game/kb_rows{kb_page}.png" },
          ] },
          // Rows the cursor has left, going back to blue under their letters.
          { "type": "group", "repeat": "3", "repeat_var": "n", "rect": ["kb_t{n}_x", "kb_t{n}_y", 440, 76], "clip": true,
            "visible": "kb_t{n}_op > 0", "children": [
            { "type": "image", "rect": [0, 0, 440, 76], "src": "assets/game/kb_bar.png", "opacity": "kb_t{n}_op" },
            { "type": "image", "rect": ["96 - kb_t{n}_x", "216 - kb_t{n}_y", 1048, 608], "src": "assets/game/kb_black{kb_page}.png" },
          ] },
          { "type": "group", "rect": [0, 0, 1240, 1080], "visible": "kb_cur", "children": [
            { "type": "image", "rect": ["kb_bar_x", "kb_bar_y", 440, 76], "src": "assets/game/kb_bar.png" },
            // Its row's letters over it, the glow, the ball, and the key under the cursor in white, as the game draws them.
            { "type": "group", "rect": ["kb_bar_x", "kb_bar_y", 440, 76], "clip": true, "children": [
              { "type": "image", "rect": ["96 - kb_bar_x", "216 - kb_bar_y", 1048, 608], "src": "assets/game/kb_black{kb_page}.png" },
            ] },
            { "type": "image", "rect": ["kb_ball_x + 46 - kb_glow_s / 2", "kb_ball_y + 46 - kb_glow_s / 2", "kb_glow_s", "kb_glow_s"],
              "src": "assets/game/kb_glow.png", "fill": "stretch", "opacity": "kb_glow_op" },
            { "type": "image", "rect": ["kb_ball_x", "kb_ball_y", 92, 92], "src": "assets/game/kb_ball.png" },
            { "type": "group", "rect": ["kb_key_x", "kb_key_y", 68, 68], "clip": true, "children": [
              { "type": "image", "rect": ["96 - kb_key_x", "216 - kb_key_y", 1048, 608], "src": "assets/game/kb_white{kb_page}.png" },
            ] },
          ] },
          // The keys' rows on the page: 2 blocks of 6 rows of 5.
          { "type": "group", "repeat": "2", "repeat_var": "b", "rect": ["176 + 440 * {b}", 320, 436, 384], "children": [
            { "type": "group", "repeat": "6", "repeat_var": "r", "rect": [0, "64 * {r}", 436, 64], "children": [
              { "type": "rect", "repeat": "5", "repeat_var": "c", "rect": ["87 * {c}", 0, 87, 64], "on_tap": { "call": "tap_key", "args": ["{b}", "{r}", "{c}"] } },
            ] },
          ] },
          // The name as the game lays it out: two lines of 8, each letter on its line, the text cursor under the
          // letter it's on.
          { "type": "image", "repeat": "16", "visible": "kb_n{i} >= 0", "rect": ["334 + 72 * ({i} % 8)", "40 + 80 * ({i} / 8)", 68, 68],
            "src": "assets/game/kb_k{kb_n{i}}.png" },
          { "type": "image", "visible": "kb_tc >= 0", "rect": ["336 + 72 * (kb_tc % 8)", "108 + 80 * (kb_tc / 8)", 64, 20], "src": "assets/game/kb_tcur.png" },
          { "type": "rect", "repeat": "16", "rect": ["336 + 72 * ({i} % 8)", "112 + 80 * ({i} / 8)", 64, 4], "bg": "#7B8392" },
          // The buttons, as the game's, lit when it would take them.
          { "type": "image", "rect": [82, 852, 216, 108], "src": "assets/game/kb_del_{=kb_del ? 'on' : 'off'}.png", "on_tap": { "call": "tap_kb_button", "args": ["circle"] } },
          { "type": "image", "rect": [334, 862, 196, 88], "src": "assets/game/kb_l_{=kb_l ? 'on' : 'off'}.png", "on_tap": { "call": "tap_kb_button", "args": ["l"] } },
          { "type": "image", "rect": [566, 862, 196, 88], "src": "assets/game/kb_r_{=kb_r ? 'on' : 'off'}.png", "on_tap": { "call": "tap_kb_button", "args": ["r"] } },
          { "type": "image", "rect": [798, 852, 360, 108], "src": "assets/game/kb_end_{=kb_end ? 'on' : 'off'}.png", "on_tap": { "call": "tap_kb_button", "args": ["start"] } },
          { "type": "image", "rect": [24, 74, 144, 88], "src": "assets/game/kb_prev.png", "on_tap": { "call": "tap_kb_page", "args": [-1] } },
          { "type": "image", "rect": [1072, 74, 144, 88], "src": "assets/game/kb_next.png", "on_tap": { "call": "tap_kb_page", "args": [1] } },
          // Dimmed while the game asks, the green it came in over going, and black as the game's screen goes.
          { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "#000000", "opacity": "kb_dim" },
          { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "#001400", "opacity": "kb_green" },
          { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "#000000", "opacity": "kb_out" },
        ] },
        // ---- A choice in a conversation (Yes/No and the like), here instead of on the game's screen: its box at
        // the game's size (4x), in the game's colours and font, halfway between the middle of this screen and
        // its bottom. It opens and closes from its bottom edge as the game's does. An opaque rim (20 px, 43 at the
        // right, 28 at the bottom) round a panel the scene shows through a little. Tapping an option moves the
        // cursor to it; tapping the one it's on chooses it.
        // Whatever is under it fades back as the choice opens (the name keyboard dims itself for its question).
        { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "#000000", "opacity": "0.45 * ch_open", "visible": "ch_open > 0 && kb_dim == 0" },
        // A choice the protagonist makes: they slide and fade in from the right behind the box as it opens, and
        // back out as it closes, in the outfit they're wearing (assets/game/port_*, gungnir/tools/p3p_home.py),
        // blinking now and then (the top of their face with the eyes shut, laid over it).
        // At the game's 4x, standing on the bottom of the screen with their head above the box, partly off the right.
        { "type": "group", "rect": ["480 + 320 * (1 - ch_pt)", 56, 1024, 1024],
          "visible": "ch_port && ch_pt > 0", "opacity": "ch_pt", "children": [
          { "type": "image", "rect": [0, 0, 1024, 1024], "src": "assets/game/port_{ch_who}.png" },
          { "type": "image", "rect": [0, 144, 1024, 256], "src": "assets/game/port_{ch_who}_b.png", "opacity": "ch_blink", "visible": "ch_blink > 0" },
        ] },
        { "type": "group", "rect": [76, "810 - 3 * (60 + 84 * ch_n) / 4", 1088, "60 + 84 * ch_n"], "visible": "ch_open > 0",
          "scale_y": "ch_open", "origin": [0.5, 1], "children": [
          { "type": "rect", "rect": [0, "40 + 84 * ch_n", 1088, 28], "bg": "#48000000", "radius": 16 },
          { "type": "rect", "rect": [0, 0, 1088, "60 + 84 * ch_n"], "border": 20, "border_color": "#C7D0C9", "radius": 16 },
          { "type": "rect", "rect": [1044, 20, 24, "20 + 84 * ch_n"], "bg": "#C7D0C9" },
          { "type": "rect", "rect": [20, "32 + 84 * ch_n", 1024, 8], "bg": "#C7D0C9" },
          { "type": "rect", "rect": [20, 20, 1024, "12 + 84 * ch_n"], "bg": "#E6C7D0C9" },
          { "type": "rect", "rect": [32, "32 + 84 * ch_cursor", 1000, 80], "bg": "ch_bar", "radius": 6 },
          { "type": "group", "rect": [0, 0, 1088, "60 + 84 * ch_n"], "visible": "ch_text", "children": [
            // The game's font (gungnir/tools/p3p_font.py), its letters' ink 61 px in and 23 px below the bar's top.
            { "type": "label", "repeat": "8", "visible": "{i} < ch_n", "rect": [61, "25 + 84 * {i}", 970, 104], "text": "{ch_t{i}}",
              "font": "assets/game/font_msg_{ch_f{i}}.json", "size": 104 },
            { "type": "rect", "repeat": "8", "visible": "{i} < ch_n", "rect": [0, "28 + 84 * {i}", 1088, 84], "on_tap": { "call": "tap_choice", "args": ["{i}"] } },
          ] },
        ] },
        // ---- The Dark Hour clock (scripts/clock.lua): the pieces that fly off the bottom of the game's screen carry on
        // here, as if this screen were under it; on the green the game turns at midnight, fading out with the game's.
        // Its pieces' pictures are built by gungnir/tools/p3p_clock.py.
        { "type": "group", "rect": [0, 0, 1240, 1080], "visible": "clk_on", "children": [
          { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "#001400", "opacity": "clk_tint" },
          { "type": "image", "repeat": "12", "visible": "clk_v{i}", "rect": ["clk_x{i} - 62", "clk_y{i} - 34", 124, 68],
            "src": "assets/game/clock_numeral_{i}.png", "fill": "stretch", "rotate": "clk_r{i}" },
          { "type": "shape", "rect": [0, 0, 1240, 1080], "antialias": true, "shapes": [
            { "kind": "path", "d": "{clk_path}", "fill": "#0C6E2C" } ] },
        ] },
      ],
    },
  },
}
