// Persona 3 Portable (USA): the title screen and Config, on the second screen, following the game.
// - Black while the game loads, then the title's own art, fading in and breathing as the game's does.
// - PRESS ANY BUTTON: tap anywhere.
// - The menu: NEW GAME, LOAD GAME, CONFIG, DATA INSTALL, the highlight sliding as the game's does; tap one.
// - Config: every row with its switch and help line; tap ON or OFF to switch, OK to confirm, Back to leave.
// The game's own menu, highlight and Config are hidden on its screen while this pack runs.
// Taps snap the game's cursor and press its button (scripts/main.lua). The title art is the game's,
// as is Config's, built from your own dump with gungnir/tools/p3p_assets.py.
{
  "script": "scripts/main.lua",
  "update_hz": 60,
  "values": {
    "screen": { "state": "idle" },
    "fade_art": { "state": 1 }, "fade_bg": { "state": 1 }, "fade_text": { "state": 1 }, "breath": { "state": 1 },
    "female_op": { "state": 1 }, "male_op": { "state": 0 }, "female_dx": { "state": 0 }, "male_dx": { "state": 0 },
    "cursor": { "state": 1 }, "pill": { "state": 1 }, "menu_op": { "state": 1 },
    "cfg_panel": { "state": 1 }, "cfg_rows": { "state": 1 },
    "black": { "state": 0 }, "white": { "state": 0 }, "flood_blue": { "state": 0 }, "flood_pink": { "state": 0 },
    "trail_d0": { "state": 3 }, "trail_d1": { "state": 2 }, "trail_d2": { "state": 1 }, "trail_d3": { "state": 0 },
    "trail_f0": { "state": 0.84 }, "trail_f1": { "state": 0.42 }, "trail_f2": { "state": 0.05 }, "trail_f3": { "state": 0 },
    "row": { "state": 0 },
    "ch_open": { "state": 0 }, "ch_text": { "state": 0 }, "ch_n": { "state": 2 }, "ch_cursor": { "state": 0 }, "ch_bar": { "state": "#428AFF" },
    "ch_t0": { "state": "" }, "ch_t1": { "state": "" }, "ch_t2": { "state": "" }, "ch_t3": { "state": "" },
    "ch_t4": { "state": "" }, "ch_t5": { "state": "" }, "ch_t6": { "state": "" }, "ch_t7": { "state": "" },
    "ch_f0": { "state": "white" }, "ch_f1": { "state": "white" }, "ch_f2": { "state": "white" }, "ch_f3": { "state": "white" },
    "ch_f4": { "state": "white" }, "ch_f5": { "state": "white" }, "ch_f6": { "state": "white" }, "ch_f7": { "state": "white" },
    "v0": { "state": 1 }, "v1": { "state": 0 }, "v2": { "state": 1 },
    "v3": { "state": 1 }, "v4": { "state": 0 }, "v5": { "state": 0 },
    "busy": { "state": 0 },
  },
  "colors": {
    "cfg_header": "#2695FF",
    "cfg_body": "#6CB0F9",
    "cfg_dark": "#003B5D",
    "cfg_yellow": "#FFC347",
    "sel_him": "#509BF9",
    "sel_her": "#FB8BDE",
    "sel_him_dark": "#1E83FE",
    "sel_her_dark": "#F961D2",
  },
  "start": "home",
  "pages": {
    "home": {
      "bg": "#000000",
      "widgets": [
        // ---- the title: the game's own art (assets/game, built by gungnir/tools/p3p_assets.py) at the
        // top screen's 4x, rearranged for this narrower canvas. Each part fades in when the game's does.
        { "type": "group", "rect": [0, 0, 1240, 1080], "visible": "screen != 'idle' && screen != 'select'", "children": [
          { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "#020328", "opacity": "fade_art" },
          { "type": "image", "rect": [0, 0, 1240, 1080], "src": "assets/gradient.png", "fill": "stretch", "opacity": "fade_bg * breath" },
          { "type": "image", "rect": ["300 + 180 * (1 - fade_bg)", -216, 1024, 1024], "src": "assets/game/moon.png", "fill": "stretch", "opacity": "fade_bg" },
          { "type": "image", "rect": [740, 584, 512, 512], "src": "assets/game/creature.png", "fill": "stretch", "opacity": "fade_bg" },
          // The other protagonist from the game's, swapping as the game's do.
          { "type": "image", "rect": ["-200 + female_dx", -21, 1024, 1126], "src": "assets/game/art_female.png", "fill": "stretch", "opacity": "fade_art * female_op" },
          { "type": "image", "rect": ["-200 + male_dx", -21, 1024, 1126], "src": "assets/game/art_male.png", "fill": "stretch", "opacity": "fade_art * male_op" },

          // PRESS ANY BUTTON: anywhere is the button.
          { "type": "rect", "rect": [0, 0, 1240, 1080], "visible": "screen == 'pab'", "on_tap": { "call": "tap_any" } },
          { "type": "image", "rect": [576, 872, 604, 36], "src": "assets/game/text_pab.png", "fill": "stretch", "visible": "screen == 'fade' || screen == 'pab'", "opacity": "fade_text" },

          // The menu: the items in white; the game's pill slides to the chosen one as the game's does
          // (following its eased position), and the text it covers is dark. It fades out under Config, and
          // back, as the game's does.
          { "type": "group", "rect": [0, 0, 1240, 1080], "visible": "screen == 'menu' || screen == 'config'", "opacity": "menu_op", "children": [
            { "type": "image", "rect": [720, 792, 328, 32], "src": "assets/game/text_new.png", "fill": "stretch", "tint": "#F4F4F4" },
            { "type": "image", "rect": [700, 844, 360, 32], "src": "assets/game/text_load.png", "fill": "stretch", "tint": "#F4F4F4" },
            { "type": "image", "rect": [760, 894, 236, 36], "src": "assets/game/text_config.png", "fill": "stretch", "tint": "#F4F4F4" },
            { "type": "image", "rect": [692, 946, 380, 36], "src": "assets/game/text_install.png", "fill": "stretch", "tint": "#F4F4F4" },
            { "type": "group", "rect": [644, "784 + 52 * pill", 476, 48], "clip": true, "children": [
              { "type": "image", "rect": [0, 0, 40, 48], "src": "assets/game/pill_left.png", "fill": "stretch" },
              { "type": "rect", "rect": [40, 0, 396, 48], "bg": "#FEFEFE" },
              { "type": "image", "rect": [436, 0, 40, 48], "src": "assets/game/pill_right.png", "fill": "stretch" },
              { "type": "image", "rect": [76, "8 - 52 * pill", 328, 32], "src": "assets/game/text_new.png", "fill": "stretch", "tint": "#0F0F30" },
              { "type": "image", "rect": [56, "60 - 52 * pill", 360, 32], "src": "assets/game/text_load.png", "fill": "stretch", "tint": "#0F0F30" },
              { "type": "image", "rect": [116, "110 - 52 * pill", 236, 36], "src": "assets/game/text_config.png", "fill": "stretch", "tint": "#0F0F30" },
              { "type": "image", "rect": [48, "162 - 52 * pill", 380, 36], "src": "assets/game/text_install.png", "fill": "stretch", "tint": "#0F0F30" },
            ] },
            // Taps: each item's whole row, wider than its pill.
            { "type": "rect", "rect": [560, 778, 680, 52], "on_tap": { "call": "tap_menu", "args": [0] } },
            { "type": "rect", "rect": [560, 830, 680, 52], "on_tap": { "call": "tap_menu", "args": [1] } },
            { "type": "rect", "rect": [560, 882, 680, 52], "on_tap": { "call": "tap_menu", "args": [2] } },
            { "type": "rect", "rect": [560, 934, 680, 52], "on_tap": { "call": "tap_menu", "args": [3] } },
          ] },

          { "type": "image", "rect": [696, 1028, 504, 48], "src": "assets/game/text_copyright.png", "fill": "stretch",
            "opacity": "fade_text * (screen == 'config' ? menu_op : 1)" },
        ] },

        // ---- Config: the game's own look (assets/game/cfg_*, built by gungnir/tools/p3p_assets.py) at 4x,
        // moved 340 px left to fit; the CONFIG word and the button prompts moved in further. Over the title,
        // fading in and out as the game's does: the panel (cfg_panel), then its rows (cfg_rows).
        { "type": "group", "rect": [0, 0, 1240, 1080], "visible": "screen == 'config'", "children": [
          { "type": "rect", "rect": [0, 76, 1240, 80], "bg": "cfg_header", "opacity": "cfg_panel" },
          { "type": "rect", "rect": [0, 156, 1240, 848], "bg": "cfg_body", "opacity": "cfg_panel" },
          { "type": "rect", "rect": [124, 156, 28, 20], "bg": "cfg_dark", "opacity": "cfg_panel" },
          { "type": "image", "rect": [40, 80, 576, 80], "src": "assets/game/cfg_title.png", "fill": "stretch", "tint": "#C0E3FB", "opacity": "cfg_panel" },

          // Each row: its bar and underline, or the dark plate when it's selected; its name (tap: select it).
          { "type": "group", "repeat": "7", "rect": [0, "185 + 92 * {i}", 1240, 78], "opacity": "cfg_rows", "children": [
            { "type": "rect", "rect": [124, 0, 28, 78], "bg": "cfg_dark", "visible": "row != {i}" },
            { "type": "rect", "rect": [152, 72, 657, 6], "bg": "cfg_dark", "visible": "row != {i}" },
            { "type": "rect", "rect": [809, 0, 319, 78], "bg": "cfg_dark", "visible": "row != {i}" },
            { "type": "rect", "rect": [124, -8, 1016, 94], "bg": "cfg_dark", "radius": 3, "visible": "row == {i}" },
            { "type": "image", "rect": [152, -13, 600, 105], "src": "assets/game/cfg_label_{i}.png", "fill": "none",
              "tint": "row == {i} ? '#FFFFFF' : '#003B5D'" },
            { "type": "rect", "rect": [124, -8, 685, 94], "on_tap": { "call": "tap_row", "args": ["{i}"] } },
          ] },

          // The six switches: the yellow half on the side that's set, with the slanted edge; NONE for Auto
          // Text while Voices is OFF. Tap ON or OFF to set it.
          { "type": "group", "repeat": "6", "rect": [0, "185 + 92 * {i}", 1240, 78], "opacity": "cfg_rows", "children": [
            { "type": "shape", "rect": [809, 0, 319, 78], "antialias": true, "visible": "{i} != 1 || v0 == 1", "shapes": [
              { "kind": "polygon", "points": [[0, 0], [195, 0], [117, 78], [0, 78]], "fill": "cfg_yellow", "visible": "v{i} == 1" },
              { "kind": "polygon", "points": [[195, 0], [319, 0], [319, 78], [117, 78]], "fill": "cfg_yellow", "visible": "v{i} == 0" },
            ] },
            { "type": "image", "rect": [848, 27, 68, 28], "src": "assets/game/cfg_on.png", "fill": "stretch", "visible": "{i} != 1 || v0 == 1",
              "tint": "v{i} == 1 ? '#003B5D' : '#2695FF'" },
            { "type": "image", "rect": [1008, 27, 96, 28], "src": "assets/game/cfg_off.png", "fill": "stretch", "visible": "{i} != 1 || v0 == 1",
              "tint": "v{i} == 0 ? '#003B5D' : '#2695FF'" },
            { "type": "image", "rect": [900, 27, 136, 28], "src": "assets/game/cfg_none.png", "fill": "stretch", "visible": "{i} == 1 && v0 == 0", "tint": "#2695FF" },
            { "type": "rect", "rect": [809, -8, 160, 94], "on_tap": { "call": "tap_switch", "args": ["{i}", 1] } },
            { "type": "rect", "rect": [969, -8, 171, 94], "on_tap": { "call": "tap_switch", "args": ["{i}", 0] } },
          ] },

          // Confirm: OK.
          { "type": "image", "rect": [932, 764, 68, 28], "src": "assets/game/cfg_ok.png", "fill": "stretch", "tint": "#2695FF", "opacity": "cfg_rows" },
          { "type": "rect", "rect": [809, 729, 331, 94], "on_tap": { "call": "tap_confirm" } },

          // The selected row's help.
          { "type": "image", "rect": [128, 852, 32, 28], "src": "assets/game/cfg_arrow.png", "fill": "stretch", "tint": "#003B5D", "opacity": "cfg_rows" },
          { "type": "image", "rect": [156, 813, 1000, 160], "src": "assets/game/cfg_help_{row}.png", "fill": "none", "tint": "#003B5D", "opacity": "cfg_rows" },

          // The game's button prompts; Back is tappable.
          { "type": "group", "rect": [0, 1004, 1240, 76], "opacity": "cfg_panel", "children": [
            { "type": "image", "rect": [560, 12, 76, 68], "src": "assets/game/cfg_dpad.png", "fill": "stretch" },
            { "type": "image", "rect": [626, 11, 172, 60], "src": "assets/game/cfg_switch.png", "fill": "stretch" },
            { "type": "image", "rect": [872, 12, 64, 64], "src": "assets/game/cfg_x.png", "fill": "stretch" },
            { "type": "image", "rect": [928, 16, 84, 68], "src": "assets/game/cfg_okword.png", "fill": "stretch" },
            { "type": "image", "rect": [1044, 12, 64, 64], "src": "assets/game/cfg_o.png", "fill": "stretch" },
            { "type": "image", "rect": [1100, 12, 120, 60], "src": "assets/game/cfg_back.png", "fill": "stretch" },
          ] },
          { "type": "rect", "rect": [1030, 1004, 210, 76], "on_tap": { "call": "tap_back" } },
        ] },

        // ---- NEW GAME: black as the title fades out, then white as the game fades back in; then at the protagonist
        // select, the hovered one's colour floods over from their side (him blue, her pink).
        { "type": "group", "rect": [0, 0, 1240, 1080], "visible": "screen == 'newgame' || screen == 'select'", "children": [
          { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "#000000", "opacity": "screen == 'select' ? 1 : black" },
          { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "#FFFFFF", "opacity": "white" },
          // Each colour, with its Orpheus inside it: flat in the portrait's unselected shade (its design is for
          // later), on their protagonist's side, trailing copies outward as the portraits on the game's
          // screen do. Only what their colour covers shows, so each is revealed as it floods.
          { "type": "group", "rect": [0, 0, "flood_blue", 1080], "clip": true, "visible": "screen == 'select'", "children": [
            { "type": "rect", "rect": [0, 0, 1240, 1080], "bg": "sel_him" },
            { "type": "image", "repeat": "4", "rect": ["-192 - 80 * trail_d{i}", 56, 1024, 1024], "src": "assets/game/orpheus_male_flat.png", "fill": "stretch",
              "tint": "mix('#1579F4', '#509BF9', trail_f{i})" },
            { "type": "image", "rect": [-192, 56, 1024, 1024], "src": "assets/game/orpheus_male_flat.png", "fill": "stretch", "tint": "sel_him_dark" },
          ] },
          { "type": "group", "rect": ["1240 - flood_pink", 0, "flood_pink", 1080], "clip": true, "visible": "screen == 'select'", "children": [
            { "type": "rect", "rect": ["flood_pink - 1240", 0, 1240, 1080], "bg": "sel_her" },
            { "type": "image", "repeat": "4", "rect": ["flood_pink - 1016 + 80 * trail_d{i}", 56, 1024, 1024], "src": "assets/game/orpheus_female_flat.png", "fill": "stretch",
              "tint": "mix('#F059C9', '#FB8BDE', trail_f{i})" },
            { "type": "image", "rect": ["flood_pink - 1016", 56, 1024, 1024], "src": "assets/game/orpheus_female_flat.png", "fill": "stretch", "tint": "sel_her_dark" },
          ] },
          // Taps: his half and hers (hover, then choose).
          { "type": "rect", "rect": [0, 0, 620, 1080], "visible": "screen == 'select'", "on_tap": { "call": "tap_pick", "args": [0] } },
          { "type": "rect", "rect": [620, 0, 620, 1080], "visible": "screen == 'select'", "on_tap": { "call": "tap_pick", "args": [1] } },
        ] },
        // ---- A choice in a conversation (Yes/No and the like), here instead of on the game's screen: its box at
        // the game's size (4x), in the game's colours and font, halfway between the middle of this screen and
        // its bottom. It opens and closes from its bottom edge as the game's does. An opaque rim (20 px, 43 at the
        // right, 28 at the bottom) round a panel the scene shows through a little. Tapping an option moves the
        // cursor to it; tapping the one it's on chooses it.
        { "type": "group", "rect": [76, "810 - 3 * (60 + 84 * ch_n) / 4", 1088, "60 + 84 * ch_n"], "visible": "ch_open > 0",
          "scale_y": "ch_open", "origin": [0.5, 1], "children": [
          { "type": "rect", "rect": [0, "40 + 84 * ch_n", 1088, 28], "bg": "#48000000", "radius": 16 },
          { "type": "rect", "rect": [0, 0, 1088, "60 + 84 * ch_n"], "border": 20, "border_color": "#C7D0C9", "radius": 16 },
          { "type": "rect", "rect": [1044, 20, 24, "20 + 84 * ch_n"], "bg": "#C7D0C9" },
          { "type": "rect", "rect": [20, "32 + 84 * ch_n", 1024, 8], "bg": "#C7D0C9" },
          { "type": "rect", "rect": [20, 20, 1024, "12 + 84 * ch_n"], "bg": "#E6C7D0C9" },
          { "type": "rect", "rect": [32, "32 + 84 * ch_cursor", 1000, 80], "bg": "ch_bar", "radius": 6 },
          { "type": "group", "rect": [0, 0, 1088, "60 + 84 * ch_n"], "visible": "ch_text", "children": [
            // The game's font (gungnir/tools/p3p_font.py), its letters' ink 61 px in and 23 px below the bar's top.
            { "type": "label", "repeat": "8", "visible": "{i} < ch_n", "rect": [61, "25 + 84 * {i}", 970, 104], "text": "{ch_t{i}}",
              "font": "assets/game/font_msg_{ch_f{i}}.json", "size": 104 },
            { "type": "rect", "repeat": "8", "visible": "{i} < ch_n", "rect": [0, "28 + 84 * {i}", 1088, 84], "on_tap": { "call": "tap_choice", "args": ["{i}"] } },
          ] },
        ] },
      ],
    },
  },
}
